{
  "name": "afterlink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @afterlink/web",
    "relay": "npm run dev -w @afterlink/relay",
    "build": "npm run build -w @afterlink/web",
    "typecheck": "tsc -b --noEmit false 2>/dev/null || tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lab": "tsx packages/lab/src/cli.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "axe-core": "^4.14.0",
    "fast-check": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
