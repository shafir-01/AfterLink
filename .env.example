# Runtime configuration for the relay. Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# n8n: production webhook that receives debrief reports, and the shared secret for both directions
N8N_WEBHOOK_URL=
N8N_INGRESS_SECRET=
# Optional
ELEVENLABS_VOICE_MEDICS=
ELEVENLABS_VOICE_ACCESS=
ELEVENLABS_VOICE_FACILITIES=
ELEVENLABS_VOICE_SUPPLY=
ELEVENLABS_VOICE_SYSTEM=
VOICE_CACHE_DIR=
AFTERLINK_ADMIN_TOKEN=
AFTERLINK_DAILY_AI_CALLS=200
AFTERLINK_AI_ENABLED=true
AFTERLINK_WEB_ORIGIN=
PORT=8787
