      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const base = $('Validate and assign id').first().json;\nconst t = $input.first().json;\nconst triage = t && t.statusCode >= 200 && t.statusCode < 300 && t.body && typeof t.body === 'object' ? t.body : null;\nconst text = (base.request.title + ' ' + base.request.description).toLowerCase();\nconst rules = [\n  { re: /(collaps|unconscious|faint|bleed|injur|hurt|allerg|asthma|chest|first aid|medic|not breathing|seizure)/, kind: 'medical', priority: 1, requires: ['first-aid'] },\n  { re: /(wheelchair|mobility|cannot walk|can't walk|stuck|evacuat|elderly)/, kind: 'mobility', priority: 1, requires: ['mobility'] },\n  { re: /(broken|leak|spill|fallen|barrier|power|repair|blocked|unsafe|fence|stage)/, kind: 'repair', priority: 2, requires: ['repair'] },\n  { re: /(water|food|supplies|deliver|haul|stock|restock|carry)/, kind: 'haul', priority: 3, requires: ['haul'] },\n];\nconst hit = rules.find((r) => r.re.test(text));\nconst fromRules = hit ? { kind: hit.kind, priority: hit.priority, requires: hit.requires } : { kind: 'assist', priority: 3, requires: [] };\nconst ok = triage && typeof triage.kind === 'string' && [1, 2, 3].includes(Number(triage.priority));\nconst classification = ok\n  ? { kind: triage.kind, priority: Number(triage.priority), requires: Array.isArray(triage.requires) ? triage.requires.map(String) : fromRules.requires, ...(Array.isArray(triage.needs) ? { needs: triage.needs } : {}), method: 'triage' }\n  : { ...fromRules, method: 'rules' };\nreturn [{ json: { sourceId: base.sourceId, payload: { sourceId: base.sourceId, request: base.request, classification }, classification } }];"
      }
