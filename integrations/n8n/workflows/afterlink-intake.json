        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const sent = $('Load dead letters').all();\nconst store = $getWorkflowStaticData('global');\nconst delivered = new Set();\n$input.all().forEach((item, i) => {\n  const code = item.json.statusCode;\n  if (code >= 200 && code < 300) delivered.add(sent[i].json.sourceId);\n});\nstore.deadLetters = (store.deadLetters || []).filter((d) => {\n  if (delivered.has(d.sourceId)) return false;\n  d.tries = (d.tries || 0) + 1;\n  return true;\n});\nstore.redelivered = (store.redelivered || 0) + delivered.size;\nreturn [{ json: { redelivered: delivered.size, stillHeld: store.deadLetters.length, totalRedelivered: store.redelivered } }];"
