        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r = $input.first().json;\nconst c = $('Classify').first().json;\nconst body = r.body && typeof r.body === 'object' ? r.body : {};\nlet attempts = 1;\nfor (const n of ['Deliver attempt 2', 'Deliver attempt 3', 'Deliver attempt 4']) { try { if ($(n).isExecuted) attempts++; } catch (e) {} }\nreturn [{ json: {\n  sourceId: c.sourceId,\n  state: body.state === 'delivered' ? 'delivered' : 'queued-at-relay',\n  duplicate: Boolean(body.duplicate),\n  taskId: body.taskId || null,\n  classification: c.classification,\n  attempts,\n  detail: body.state === 'delivered' ? 'A connected device received the request.' : 'The relay holds the request until a device connects.',\n} }];"
