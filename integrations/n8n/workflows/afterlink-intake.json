        "jsCode": "const c = $('Classify').first().json;\nconst store = $getWorkflowStaticData('global');\nstore.deadLetters = store.deadLetters || [];\nif (!store.deadLetters.some((d) => d.sourceId === c.sourceId)) {\n  store.deadLetters.push({ sourceId: c.sourceId, payload: c.payload, failedAt: new Date().toISOString(), tries: 4 });\n}\nreturn [{ json: { sourceId: c.sourceId, state: 'held-for-retry', classification: c.classification, attempts: 4, detail: 'The relay did not answer. The request is stored and retried every two minutes.', held: store.deadLetters.length } }];"
