        780,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json;\nconst b = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst s = (v) => (typeof v === 'string' ? v.trim() : '');\nconst errors = [];\nconst title = s(b.title).slice(0, 120);\nconst description = s(b.description).slice(0, 500);\nconst locationName = s(b.locationName).slice(0, 80);\nconst contact = s(b.contact).slice(0, 120);\nif (title.length < 3) errors.push('title is required (3 to 120 characters)');\nlet location;\nif (b.location && Number.isFinite(Number(b.location.x)) && Number.isFinite(Number(b.location.y))) {\n  const c = (n) => Math.min(100, Math.max(0, Number(n)));\n  location = { x: c(b.location.x), y: c(b.location.y) };\n}\nconst supplied = s(b.sourceId);\nif (supplied && !/^[A-Za-z0-9._:-]{8,128}$/.test(supplied)) errors.push('sourceId must be 8 to 128 characters of letters, digits, . _ : -');\nconst fnv = (str, seed) => { let h = seed >>> 0; for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0; } return h.toString(16).padStart(8, '0'); };\nconst basis = [title, description, locationName, contact].join('|').toLowerCase();\nconst sourceId = supplied || 'req-' + fnv(basis, 2166136261) + fnv(basis, 3339675911);\nconst request = { title, description, locationName };\nif (location) request.location = location;\nreturn [{ json: { valid: errors.length === 0, errors, sourceId, request, contact, receivedAt: new Date().toISOString() } }];"
      }
